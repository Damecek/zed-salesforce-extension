[
  {
    "label": "sf: data search (file)",
    "command": "sf data search --query \"$(cat \"$ZED_FILE\")\"",
    "cwd": "$ZED_WORKTREE_ROOT",
    "allow_concurrent_runs": true,
    "use_new_terminal": true,
    "show_command": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "sf: data search (file, pick org)",
    "command": "printf 'Target org alias (blank=default): ' && read ORG; sf data search --query \"$(cat \"$ZED_FILE\")\" ${ORG:+--target-org} ${ORG:+\"$ORG\"}",
    "cwd": "$ZED_WORKTREE_ROOT",
    "allow_concurrent_runs": true,
    "use_new_terminal": true,
    "show_command": false,
    "reveal": "always",
    "hide": "never"
  }
]
