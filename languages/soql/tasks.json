[
  {
    "label": "sf: data query (file)",
    "command": "sf data query --file \"$ZED_FILE\" --result-format human",
    "cwd": "$ZED_WORKTREE_ROOT",
    "allow_concurrent_runs": true,
    "use_new_terminal": true,
    "show_command": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "sf: data query (file, pick org)",
    "command": "printf 'Target org alias (blank=default): ' && read ORG; sf data query --file \"$ZED_FILE\" --result-format human ${ORG:+--target-org} ${ORG:+\"$ORG\"}",
    "cwd": "$ZED_WORKTREE_ROOT",
    "allow_concurrent_runs": true,
    "use_new_terminal": true,
    "show_command": false,
    "reveal": "always",
    "hide": "never"
  }
]
